<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<TabPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.initial.controller.MainController">
    <tabs>
        <!-- Patient Tab -->
        <Tab text="Patients">
            <VBox spacing="10" padding="10">
                <HBox spacing="10">
                    <TextField fx:id="patientFirstName" promptText="First Name"/>
                    <TextField fx:id="patientLastName" promptText="Last Name"/>
                    <TextField fx:id="patientEmail" promptText="Email"/>
                    <TextField fx:id="patientPhone" promptText="Phone Number"/>
                    <TextField fx:id="patientPassword" promptText="Password"/>
                    <TextField fx:id="patientAddress" promptText="Address"/>
                    <Button text="Add Patient" onAction="#addPatient"/>
                </HBox>
                <TableView fx:id="patientTable">
                    <columns>
                        <TableColumn text="ID" fx:id="patientIdColumn"/>
                        <TableColumn text="First Name" fx:id="patientFirstNameColumn"/>
                        <TableColumn text="Last Name" fx:id="patientLastNameColumn"/>
                        <TableColumn text="Email" fx:id="patientEmailColumn"/>
                        <TableColumn text="Phone" fx:id="patientPhoneColumn"/>
                    </columns>
                </TableView>
                <HBox spacing="10">
                    <Button text="Update Selected" onAction="#updatePatient"/>
                    <Button text="Delete Selected" onAction="#deletePatient"/>
                </HBox>
            </VBox>
        </Tab>

        <!-- Doctor Tab -->
        <Tab text="Doctors">
            <VBox spacing="10" padding="10">
                <HBox spacing="10">
                    <TextField fx:id="doctorFirstName" promptText="First Name"/>
                    <TextField fx:id="doctorLastName" promptText="Last Name"/>
                    <TextField fx:id="doctorEmail" promptText="Email"/>
                    <TextField fx:id="doctorPassword" promptText="Password"/>
                    <TextField fx:id="doctorSpecialization" promptText="Specialization"/>
                    <ComboBox fx:id="doctorDepartment" promptText="Department"/>
                    <Button text="Add Doctor" onAction="#addDoctor"/>
                </HBox>
                <TableView fx:id="doctorTable">
                    <columns>
                        <TableColumn text="ID" fx:id="doctorIdColumn"/>
                        <TableColumn text="First Name" fx:id="doctorFirstNameColumn"/>
                        <TableColumn text="Last Name" fx:id="doctorLastNameColumn"/>
                        <TableColumn text="Email" fx:id="doctorEmailColumn"/>
                        <TableColumn text="Specialization" fx:id="doctorSpecializationColumn"/>
                        <TableColumn text="Department" fx:id="doctorDepartmentColumn"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <!-- Appointment Tab -->
        <Tab text="Appointments">
            <VBox spacing="10" padding="10">
                <HBox spacing="10">
                    <DatePicker fx:id="appointmentDate" promptText="Date"/>
                    <ComboBox fx:id="appointmentDoctor" promptText="Doctor"/>
                    <ComboBox fx:id="appointmentPatient" promptText="Patient"/>
                    <Button text="Add Appointment" onAction="#addAppointment"/>
                </HBox>
                <TableView fx:id="appointmentTable">
                    <columns>
                        <TableColumn text="ID" fx:id="appointmentIdColumn"/>
                        <TableColumn text="Date" fx:id="appointmentDateColumn"/>
                        <TableColumn text="Doctor" fx:id="appointmentDoctorColumn"/>
                        <TableColumn text="Patient" fx:id="appointmentPatientColumn"/>
                        <TableColumn text="Status" fx:id="appointmentStatusColumn"/>
                    </columns>
                </TableView>
                <HBox spacing="10">
                    <Button text="Cancel Selected" onAction="#cancelAppointment"/>
                    <Button text="Reschedule Selected" onAction="#rescheduleAppointment"/>
                    <Button text="Delete Selected" onAction="#deleteAppointment"/>
                </HBox>
            </VBox>
        </Tab>

        <!-- Department Tab -->
        <Tab text="Departments">
            <VBox spacing="10" padding="10">
                <HBox spacing="10">
                    <TextField fx:id="departmentName" promptText="Department Name"/>
                    <TextField fx:id="departmentDescription" promptText="Description"/>
                    <Button text="Add Department" onAction="#addDepartment"/>
                </HBox>
                <TableView fx:id="departmentTable">
                    <columns>
                        <TableColumn text="ID" fx:id="departmentIdColumn"/>
                        <TableColumn text="Name" fx:id="departmentNameColumn"/>
                        <TableColumn text="Description" fx:id="departmentDescriptionColumn"/>
                    </columns>
                </TableView>
                <HBox spacing="10">
                    <Button text="Update Selected" onAction="#updateDepartment"/>
                    <Button text="Delete Selected" onAction="#deleteDepartment"/>
                </HBox>
            </VBox>
        </Tab>

        <!-- Login Tab -->
        <Tab text="Login">
            <VBox spacing="10" padding="10" alignment="CENTER">
                <ComboBox fx:id="loginType" promptText="Login As">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Patient" />
                            <String fx:value="Doctor" />
                        </FXCollections>
                    </items>
                </ComboBox>
                <TextField fx:id="loginEmail" promptText="Email"/>
                <PasswordField fx:id="loginPassword" promptText="Password"/>
                <Button text="Login" onAction="#login"/>
            </VBox>
        </Tab>
    </tabs>
</TabPane>