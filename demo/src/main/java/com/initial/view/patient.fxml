<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.initial.controller.DepartmentListController"
      stylesheets="@patient.css">

    <!-- Navigation Bar -->
    <HBox styleClass="navbar">
        <Button text="Hospital Departments" styleClass="navbar-brand" onAction="#navigateTodepartemnt"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="About Us" onAction="#navigateToAboutUs" styleClass="nav-button"/>
        <Button text="My Appointments" onAction="#navigateToAppointments" styleClass="nav-button"/>
    </HBox>

    <!-- Departments Container -->
    <ScrollPane fitToWidth="true" styleClass="content-area">
        <FlowPane fx:id="departmentsContainer" 
                  hgap="20" 
                  vgap="20" 
                  prefWrapLength="900">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
        </FlowPane>
    </ScrollPane>
</VBox>